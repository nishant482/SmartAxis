{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/apps/sanatan-wallpapers",
      "destination": "/apps/sanatan-wallpapers.html"
    },
    {
      "source": "/websites",
      "destination": "/websites.html"
    },
    {
      "destination": "/api",
      "source": "/sitemap-blogs.xml"
    },
    {
      "destination": "/shell.html",
      "source": "/blogs/:slug"
    },
    {
      "destination": "/blogs.html",
      "source": "/blogs"
    },
    {
      "destination": "/apps.html",
      "source": "/apps"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api"
    },
    {
      "source": "/sitemap-projects.xml",
      "destination": "/api"
    },
    {
      "source": "/admin/:path*",
      "destination": "/shell.html"
    },
    {
      "source": "/portfolio/:id",
      "destination": "/shell.html"
    },
    {
      "source": "/services/:slug",
      "destination": "/services/:slug.html"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/solutions",
      "destination": "/solutions.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "destination": "/",
      "permanent": true,
      "source": "/process"
    },
    {
      "source": "/portfolio",
      "destination": "/websites",
      "permanent": true
    }
  ]
}
